model Hospital {
  id String @id @default(cuid())

  // Basic Information
  hospitalCode  String  @unique
  hospitalName  String
  legalName     String?
  hospitalType  String // General, Multi-Speciality, Clinic, Diagnostic, Dental
  ownershipType String? // Private, Government, Trust, NGO

  // Contact Information
  email          String  @unique
  phone          String
  alternatePhone String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String

  // Registration
  registrationNumber String? @unique
  taxNumber          String?
  licenseNumber      String?
  accreditation      String? // NABH, JCI, ISO

  // Branding
  logo    String?
  website String?

  // Timezone
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  // Status
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  users         User[]
  hospitalTheme HospitalTheme?
  branches      BranchManage[]
  branchAdmins  BranchAdmin[]
  roles         Role[]
  roleAssignments UserRoleAssignment[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  manageDepartments ManageDepartment[]
  manageFees        ManageFee[]
  departmentTypes   DepartmentType[]
}

model HospitalAdmin {
  id String @id @default(cuid())

  // Link to Global Identity
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  employeeCode String? @unique
  middleName   String?
  displayName  String?

  // Contact
  phone           String
  alternatePhone  String?
  profileImageUrl String?

  // Account Status
  status          AccountStatus @default(PENDING)
  isEmailVerified Boolean       @default(false)
  isPhoneVerified Boolean       @default(false)

  // Login Security
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // MFA
  mfaEnabled Boolean @default(false)

  // Audit
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalTheme {
  id String @id @default(cuid())

  // Relationship
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Branding
  hospitalLogo    String?
  favicon         String?
  loginBackground String?

  // Theme Colors
  primaryColor     String @default("#2563EB")
  secondaryColor   String @default("#1E40AF")
  accentColor      String @default("#10B981")
  sidebarColor     String @default("#FFFFFF")
  sidebarTextColor String @default("#1F2937")
  headerColor      String @default("#FFFFFF")
  headerTextColor  String @default("#111827")
  backgroundColor  String @default("#F8FAFC")
  cardColor        String @default("#FFFFFF")
  borderColor      String @default("#E5E7EB")
  buttonColor      String @default("#2563EB")
  buttonTextColor  String @default("#FFFFFF")
  linkColor        String @default("#2563EB")
  successColor     String @default("#22C55E")
  warningColor     String @default("#F59E0B")
  errorColor       String @default("#EF4444")

  // Typography
  fontFamily String @default("Inter")
  fontSize   String @default("medium")

  // Theme Settings
  themeMode    String @default("light") // light | dark | auto
  borderRadius String @default("8px")

  // Features
  showHospitalLogo Boolean @default(true)
  showHospitalName Boolean @default(true)
  enableAnimations Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchManage {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Basic Info
  branchName   String
  branchCode   String  @unique // Unique code per branch (e.g. OWAISI-SEC-01)
  isMainBranch Boolean @default(false)

  // Contact Info
  email          String
  phone          String
  alternatePhone String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String

  // Localization
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  // Regulatory & Auditing
  licenseNumber String?
  isActive      Boolean @default(true)

  branchAdmins BranchAdmin[]
  roleAssignments UserRoleAssignment[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  manageDepartments ManageDepartment[]
  manageFees        ManageFee[]
  departmentTypes   DepartmentType[]
}

model BranchAdmin {
  id                   String        @id @default(cuid())
  // Link to Global Identity
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Personal Information
  firstName            String
  middleName           String?
  lastName             String
  fullName             String?
  employeeId           String?       @unique
  profilePhoto         String?
  gender               String?
  dateOfBirth          DateTime?
  // Contact Information
  email                String        @unique
  phoneNumber          String?
  alternatePhoneNumber String?
  // Organization
  hospitalId           String
  hospital             Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branchId             String
  branch               BranchManage  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId         String?
  designation          String?
  reportingManagerId   String?
  // Role & Permission
  // Denormalized "primary role" pointer for display/UX convenience only.
  // Actual authorization is always derived from User.roles -> RolePermission,
  // never from this field directly.
  roleId               String?
  role                 Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isSuperBranchAdmin   Boolean       @default(false)
  // Address
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  country              String?
  postalCode           String?
  status               String        @default("Active")
  accountStatus        AccountStatus @default(PENDING)
  joiningDate          DateTime?
  relievingDate        DateTime?
  // Security
  twoFactorEnabled     Boolean       @default(false)
  passwordChangedAt    DateTime?
  failedLoginAttempts  Int           @default(0)
  accountLockedUntil   DateTime?
  // Audit
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
}
