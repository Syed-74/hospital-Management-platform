// ==========================================================
// TENANT ORGANIZATION & OPERATIONS
// ==========================================================
// This schema owns the organizational structure each hospital tenant is
// built from, and the operational configuration hung off it:
//   - Organization:  Hospital, HospitalTheme, BranchManage
//   - Infrastructure: BranchFloor, BranchRoom, BranchWard
//   - Departments:    DepartmentType, ManageDepartment, ManageFee
//
// Identity, authentication, employment, and authorization (who works here
// and what they're allowed to do) live in identity.prisma and are only
// referenced here by id.
//
// Every model below that has both a `hospitalId` and a `branchId` (or a
// `branchId`/`floorId`/`roomId`) exposes a `@@unique([..., id])` anchor so
// identity.prisma (and models within this file) can point back to it with
// a COMPOSITE foreign key instead of a lone scalar — e.g.
// `ManageDepartment.branch` is keyed on (hospitalId, branchId), not just
// branchId, so a department can never be attached to a branch belonging to
// a different hospital. This is what makes Hospital → Branch → Department
// integrity a database guarantee rather than an application-layer hope.

// ==========================================
// ORGANIZATION
// ==========================================

model Hospital {
  id String @id @default(cuid())

  // Basic Information
  hospitalCode  String  @unique
  hospitalName  String
  legalName     String?
  hospitalType  String // General, Multi-Speciality, Clinic, Diagnostic, Dental
  ownershipType String? // Private, Government, Trust, NGO

  // Contact Information
  email          String  @unique
  phone          String
  alternatePhone String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String

  // Registration
  registrationNumber String? @unique
  taxNumber          String?
  licenseNumber      String?
  accreditation      String? // NABH, JCI, ISO

  // Branding
  logo    String?
  website String?

  // Timezone
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  // Status
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  // Identity, employment & authorization (identity.prisma)
  users                 User[]
  employees             Employee[]
  employmentAssignments EmploymentAssignment[]
  roles                 Role[]
  roleAssignments       UserRoleAssignment[]
  documentRequirements  DocumentRequirement[]

  // Organization & operations (this file)
  hospitalTheme     HospitalTheme?
  branches          BranchManage[]
  manageDepartments ManageDepartment[]
  manageFees        ManageFee[]
  departmentTypes   DepartmentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalTheme {
  id String @id @default(cuid())

  // Relationship
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Branding
  hospitalLogo    String?
  favicon         String?
  loginBackground String?

  // Theme Colors
  primaryColor     String @default("#2563EB")
  secondaryColor   String @default("#1E40AF")
  accentColor      String @default("#10B981")
  sidebarColor     String @default("#FFFFFF")
  sidebarTextColor String @default("#1F2937")
  headerColor      String @default("#FFFFFF")
  headerTextColor  String @default("#111827")
  backgroundColor  String @default("#F8FAFC")
  cardColor        String @default("#FFFFFF")
  borderColor      String @default("#E5E7EB")
  buttonColor      String @default("#2563EB")
  buttonTextColor  String @default("#FFFFFF")
  linkColor        String @default("#2563EB")
  successColor     String @default("#22C55E")
  warningColor     String @default("#F59E0B")
  errorColor       String @default("#EF4444")

  // Typography
  fontFamily String @default("Inter")
  fontSize   String @default("medium")

  // Theme Settings
  themeMode    String @default("light") // light | dark | auto
  borderRadius String @default("8px")

  // Features
  showHospitalLogo Boolean @default(true)
  showHospitalName Boolean @default(true)
  enableAnimations Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchManage {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Basic Info
  branchName   String
  // Unique per hospital, not globally — two different hospitals must be
  // free to each run their own "MAIN"/"OWAISI-SEC-01"-style code scheme
  // without colliding with each other.
  branchCode   String
  isMainBranch Boolean @default(false)

  // Contact Info
  email          String
  phone          String
  alternatePhone String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String

  // Localization
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  // Regulatory & Auditing
  licenseNumber String?
  isActive      Boolean @default(true)

  // Identity, employment & authorization (identity.prisma) — both keyed on
  // (hospitalId, branchId) composite FKs against @@unique([hospitalId, id]) below.
  employmentAssignments EmploymentAssignment[]
  roleAssignments       UserRoleAssignment[]

  // Infrastructure & operations (this file)
  branchFloors      BranchFloor[]
  branchRooms       BranchRoom[]
  branchWards       BranchWard[]
  manageDepartments ManageDepartment[]
  manageFees        ManageFee[]
  departmentTypes   DepartmentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, branchCode])
  // Anchor for every composite FK elsewhere that points at "a branch that
  // must belong to this specific hospital".
  @@unique([hospitalId, id])
}

// ==========================================
// INFRASTRUCTURE
// ==========================================

model BranchFloor {
  id          String       @id @default(cuid())
  branchId    String
  branch      BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  code        String? // e.g., "OPD-001"
  type        String // e.g., "General Ward", "ICU", "Consultation", "Private"
  isAvailable Boolean      @default(true)
  capacity    Int          @default(1)
  status      String       @default("Active")
  rooms       BranchRoom[]
  wards       BranchWard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Anchor so BranchRoom/BranchWard can reference "a floor that must
  // belong to this specific branch" via a composite FK.
  @@unique([branchId, id])
}

model BranchRoom {
  id          String       @id @default(cuid())
  branchId    String
  branch      BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId     String?
  // Composite FK to BranchFloor(branchId, id): a room's floor must belong
  // to the SAME branch as the room itself. Skipped when floorId is null.
  // Restrict, not SetNull: a composite FK's SetNull would null EVERY local
  // column (including the required branchId), which Postgres rejects — a
  // floor that still has rooms must have them reassigned first.
  floor       BranchFloor? @relation(fields: [branchId, floorId], references: [branchId, id], onDelete: Restrict)
  name        String
  code        String? // e.g., "OPD-001"
  type        String // e.g., "General Ward", "ICU", "Consultation", "Private"
  isAvailable Boolean      @default(true)
  capacity    Int          @default(1)
  status      String       @default("Active")
  wards       BranchWard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Anchor so BranchWard can reference "a room that must belong to this
  // specific branch" via a composite FK.
  @@unique([branchId, id])
}

model BranchWard {
  id          String       @id @default(cuid())
  branchId    String
  branch      BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId     String?
  // Composite FK to BranchFloor(branchId, id) — same-branch guarantee.
  // Restrict, not SetNull — see BranchRoom.floor above.
  floor       BranchFloor? @relation(fields: [branchId, floorId], references: [branchId, id], onDelete: Restrict)
  roomId      String?
  // Composite FK to BranchRoom(branchId, id) — same-branch guarantee.
  // Restrict, not SetNull — see BranchRoom.floor above.
  room        BranchRoom?  @relation(fields: [branchId, roomId], references: [branchId, id], onDelete: Restrict)
  name        String
  code        String? // e.g., "OPD-001"
  type        String // e.g., "General Ward", "ICU", "Consultation", "Private"
  isAvailable Boolean      @default(true)
  capacity    Int          @default(1)
  status      String       @default("Active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ==========================================
// DEPARTMENTS
// ==========================================

model DepartmentType {
  id String @id @default(cuid())

  hospitalId String
  branchId   String
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  // Composite FK to BranchManage(hospitalId, id): this type's branch must
  // belong to this same hospital.
  branch     BranchManage @relation(fields: [hospitalId, branchId], references: [hospitalId, id], onDelete: Cascade)

  typeName        String
  isRevenueCenter Boolean @default(false)
  isActive        Boolean @default(true)

  departments ManageDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, branchId, typeName])
  // Anchor for ManageDepartment.departmentType's composite FK.
  @@unique([hospitalId, branchId, id])
}

model ManageDepartment {
  id String @id @default(cuid())

  hospitalId String
  branchId   String
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  // Composite FK to BranchManage(hospitalId, id): this department's branch
  // must belong to this same hospital.
  branch     BranchManage @relation(fields: [hospitalId, branchId], references: [hospitalId, id], onDelete: Cascade)
  manageFees ManageFee[]

  // Important Core Attributes
  departmentName   String
  // Unique per hospital, not globally — see BranchManage.branchCode for
  // the same reasoning.
  departmentCode   String
  departmentTypeId String?
  // Composite FK to DepartmentType(hospitalId, branchId, id): the type
  // must belong to the SAME hospital+branch as this department. Skipped
  // when departmentTypeId is null. Restrict, not SetNull — a composite
  // FK's SetNull would null EVERY local column (including the required
  // hospitalId/branchId), which Postgres rejects; a type still in use must
  // be reassigned off its departments before it can be deleted.
  departmentType   DepartmentType? @relation(fields: [hospitalId, branchId, departmentTypeId], references: [hospitalId, branchId, id], onDelete: Restrict)

  // Optional but useful attributes
  description String? // Optional: Details about the department

  // Status and Flags
  isActive Boolean @default(true) // Replaces generic 'status String'

  // Staff placed in this department (identity.prisma)
  employmentAssignments EmploymentAssignment[]

  // Audit and Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, departmentCode])
  @@unique([hospitalId, branchId, departmentName])
  // Anchor for EmploymentAssignment.department / ManageFee.department's
  // composite FKs.
  @@unique([hospitalId, branchId, id])
}

model ManageFee {
  id String @id @default(cuid())

  hospitalId   String
  branchId     String
  departmentId String
  hospital     Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  // Composite FK to BranchManage(hospitalId, id): this fee's branch must
  // belong to this same hospital.
  branch       BranchManage     @relation(fields: [hospitalId, branchId], references: [hospitalId, id], onDelete: Cascade)
  // Composite FK to ManageDepartment(hospitalId, branchId, id): this fee's
  // department must belong to the SAME hospital+branch as the fee itself.
  department   ManageDepartment @relation(fields: [hospitalId, branchId, departmentId], references: [hospitalId, branchId, id], onDelete: Cascade)

  // Important Core Attributes
  feeName String
  feeCode String
  amount  Float
  tax     Float? @default(0)

  // Optional but useful attributes
  description String? // Optional: Details about the fee

  // Status and Flags
  isActive Boolean @default(true) // Replaces generic 'status String'

  // Audit and Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, branchId, feeCode])
  @@unique([hospitalId, branchId, departmentId, feeName])
}
