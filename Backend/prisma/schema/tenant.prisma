// ==========================================================
// TENANT ORGANIZATION & OPERATIONS
// ==========================================================
// This schema owns the organizational structure each hospital tenant is
// built from, and the operational configuration hung off it:
//   - Organization:  Hospital, HospitalTheme, BranchManage
//   - Infrastructure: BranchFloor, BranchRoom, BranchWard
//   - Departments:    DepartmentType, ManageDepartment, ManageFee
//
// Identity, authentication, employment, and authorization (who works here
// and what they're allowed to do) live in identity.prisma and are only
// referenced here by id.

// ==========================================
// ORGANIZATION
// ==========================================

model Hospital {
  id String @id @default(cuid())

  // Basic Information
  hospitalCode  String  @unique
  hospitalName  String
  legalName     String?
  hospitalType  String // General, Multi-Speciality, Clinic, Diagnostic, Dental
  ownershipType String? // Private, Government, Trust, NGO

  // Contact Information
  email          String  @unique
  phone          String
  alternatePhone String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String

  // Registration
  registrationNumber String? @unique
  taxNumber          String?
  licenseNumber      String?
  accreditation      String? // NABH, JCI, ISO

  // Branding
  logo    String?
  website String?

  // Timezone
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  // Status
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  // Identity, employment & authorization (identity.prisma)
  users                 User[]
  employees             Employee[]
  employmentAssignments EmploymentAssignment[]
  roles                 Role[]
  roleAssignments       UserRoleAssignment[]
  documentRequirements  DocumentRequirement[]

  // Organization & operations (this file)
  hospitalTheme     HospitalTheme?
  branches          BranchManage[]
  manageDepartments ManageDepartment[]
  manageFees        ManageFee[]
  departmentTypes   DepartmentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalTheme {
  id String @id @default(cuid())

  // Relationship
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Branding
  hospitalLogo    String?
  favicon         String?
  loginBackground String?

  // Theme Colors
  primaryColor     String @default("#2563EB")
  secondaryColor   String @default("#1E40AF")
  accentColor      String @default("#10B981")
  sidebarColor     String @default("#FFFFFF")
  sidebarTextColor String @default("#1F2937")
  headerColor      String @default("#FFFFFF")
  headerTextColor  String @default("#111827")
  backgroundColor  String @default("#F8FAFC")
  cardColor        String @default("#FFFFFF")
  borderColor      String @default("#E5E7EB")
  buttonColor      String @default("#2563EB")
  buttonTextColor  String @default("#FFFFFF")
  linkColor        String @default("#2563EB")
  successColor     String @default("#22C55E")
  warningColor     String @default("#F59E0B")
  errorColor       String @default("#EF4444")

  // Typography
  fontFamily String @default("Inter")
  fontSize   String @default("medium")

  // Theme Settings
  themeMode    String @default("light") // light | dark | auto
  borderRadius String @default("8px")

  // Features
  showHospitalLogo Boolean @default(true)
  showHospitalName Boolean @default(true)
  enableAnimations Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchManage {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Basic Info
  branchName   String
  branchCode   String  @unique // Unique code per branch (e.g. OWAISI-SEC-01)
  isMainBranch Boolean @default(false)

  // Contact Info
  email          String
  phone          String
  alternatePhone String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String

  // Localization
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  // Regulatory & Auditing
  licenseNumber String?
  isActive      Boolean @default(true)

  // Identity, employment & authorization (identity.prisma)
  employmentAssignments EmploymentAssignment[]
  roleAssignments       UserRoleAssignment[]

  // Infrastructure & operations (this file)
  branchFloors      BranchFloor[]
  branchRooms       BranchRoom[]
  branchWards       BranchWard[]
  manageDepartments ManageDepartment[]
  manageFees        ManageFee[]
  departmentTypes   DepartmentType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// INFRASTRUCTURE
// ==========================================

model BranchFloor {
  id          String       @id @default(cuid())
  branchId    String
  branch      BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  code        String? // e.g., "OPD-001"
  type        String // e.g., "General Ward", "ICU", "Consultation", "Private"
  isAvailable Boolean      @default(true)
  capacity    Int          @default(1)
  status      String       @default("Active")
  rooms       BranchRoom[]
  wards       BranchWard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BranchRoom {
  id          String       @id @default(cuid())
  branchId    String
  branch      BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId     String?
  floor       BranchFloor? @relation(fields: [floorId], references: [id], onDelete: SetNull)
  name        String
  code        String? // e.g., "OPD-001"
  type        String // e.g., "General Ward", "ICU", "Consultation", "Private"
  isAvailable Boolean      @default(true)
  capacity    Int          @default(1)
  status      String       @default("Active")
  wards       BranchWard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BranchWard {
  id          String       @id @default(cuid())
  branchId    String
  branch      BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId     String?
  floor       BranchFloor? @relation(fields: [floorId], references: [id], onDelete: SetNull)
  roomId      String?
  room        BranchRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  name        String
  code        String? // e.g., "OPD-001"
  type        String // e.g., "General Ward", "ICU", "Consultation", "Private"
  isAvailable Boolean      @default(true)
  capacity    Int          @default(1)
  status      String       @default("Active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ==========================================
// DEPARTMENTS
// ==========================================

model DepartmentType {
  id String @id @default(cuid())

  hospitalId String
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branchId   String
  branch     BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)

  typeName        String
  isRevenueCenter Boolean @default(false)
  isActive        Boolean @default(true)

  departments ManageDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, branchId, typeName])
}

model ManageDepartment {
  id String @id @default(cuid())

  hospitalId String
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branchId   String
  branch     BranchManage @relation(fields: [branchId], references: [id], onDelete: Cascade)
  manageFees ManageFee[]

  // Important Core Attributes
  departmentName   String
  departmentCode   String          @unique
  departmentTypeId String?
  departmentType   DepartmentType? @relation(fields: [departmentTypeId], references: [id], onDelete: SetNull)

  // Optional but useful attributes
  description String? // Optional: Details about the department

  // Status and Flags
  isActive Boolean @default(true) // Replaces generic 'status String'

  // Staff placed in this department (identity.prisma)
  employmentAssignments EmploymentAssignment[]

  // Audit and Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, branchId, departmentName])
}

model ManageFee {
  id String @id @default(cuid())

  hospitalId   String
  hospital     Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branchId     String
  branch       BranchManage     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId String
  department   ManageDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Important Core Attributes
  feeName String
  feeCode String
  amount  Float
  tax     Float? @default(0)

  // Optional but useful attributes
  description String? // Optional: Details about the fee

  // Status and Flags
  isActive Boolean @default(true) // Replaces generic 'status String'

  // Audit and Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([hospitalId, branchId, feeCode])
  @@unique([hospitalId, branchId, departmentId, feeName])
}
