generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  GLOBAL
  ORGANIZATION_ADMIN
  BRANCH
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MfaMethod {
  TOTP
  SMS
  EMAIL
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  gender       String?
  mobileNumber String?
  profilePhoto String?
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  credential UserCredential?
  mfaSetting UserMfaSetting?
  sessions   UserSession[]
  employee Employee?
  roleAssignments UserRoleAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, hospitalId])
  @@index([hospitalId])
}

model UserCredential {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash       String
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)
  status          AccountStatus @default(PENDING)
  isEmailVerified Boolean       @default(false)
  isPhoneVerified Boolean       @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserMfaSetting {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled Boolean    @default(false)
  method    MfaMethod?
  secretCiphertext String?
  verifiedAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String  @unique
  userAgent        String?
  ipAddress        String?
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Employee {
  id String @id @default(cuid())
  userId String @unique
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  employeeCode     String?
  middleName       String?
  displayName      String?
  alternatePhone   String?
  officeExtension  String?
  emergencyContact String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  joiningDate      DateTime?
  relievingDate    DateTime?
  employmentStatus EmploymentStatus @default(ACTIVE)
  professionalProfile ProfessionalProfile?
  documents           EmployeeDocument[]
  assignments        EmploymentAssignment[] @relation("EmployeeAssignments")
  managedAssignments EmploymentAssignment[] @relation("AssignmentReportingManager")
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@unique([hospitalId, employeeCode])
  @@unique([id, hospitalId])
  @@unique([userId, hospitalId])
  @@index([hospitalId])
}

model EmploymentAssignment {
  id String @id @default(cuid())
  employeeId String
  hospitalId String
  branchId   String?
  employee Employee      @relation("EmployeeAssignments", fields: [employeeId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  hospital Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   BranchManage? @relation(fields: [hospitalId, branchId], references: [hospitalId, id], onDelete: Cascade)
  departmentId String?
  department   ManageDepartment? @relation(fields: [hospitalId, branchId, departmentId], references: [hospitalId, branchId, id], onDelete: Restrict)
  designation String?
  isPrimary   Boolean @default(true)
  reportingManagerId String?
  reportingManager   Employee? @relation("AssignmentReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([employeeId])
  @@index([hospitalId, branchId])
  @@index([branchId])
  @@index([departmentId])
}

model ProfessionalProfile {
  id String @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  qualification String?
  license       String?
  certification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentRequirement {
  id String @id @default(cuid())
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  isMandatory Boolean @default(true)
  isActive    Boolean @default(true)
  appliesToRoleId String?
  appliesToRole   Role?   @relation(fields: [appliesToRoleId], references: [id], onDelete: SetNull)
  documents EmployeeDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([hospitalId, code])
}
model EmployeeDocument {
  id String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  label   String
  fileUrl String
  status     VerificationStatus @default(PENDING)
  verifiedBy String?
  verifiedAt DateTime?
  remarks    String?
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([employeeId])
  @@index([requirementId])
}

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?
  scope       RoleScope @default(ORGANIZATION_ADMIN)
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  assignments          UserRoleAssignment[]
  rolePermissions      RolePermission[]
  documentRequirements DocumentRequirement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([hospitalId, name])
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?
  module      String?
  rolePermissions RolePermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospitalId String?
  hospital   Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     BranchManage? @relation(fields: [hospitalId, branchId], references: [hospitalId, id], onDelete: Cascade)
  assignedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, roleId, hospitalId, branchId])
  @@index([userId])
  @@index([hospitalId, branchId])
  @@index([branchId])
}
